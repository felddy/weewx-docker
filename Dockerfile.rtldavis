ARG WEEWX_BASE_IMAGE=ghcr.io/cdavis289/weewx:5.5.2
FROM ${WEEWX_BASE_IMAGE}

USER root

# Python-only RTL-Davis continuation (no Go receiver process).
ARG RTL_DAVIS_REF=v0.22.2
RUN /opt/venv/bin/python -m pip install --no-cache-dir 'numpy>=2,<3'

# Refresh the Debian package index even when BuildKit has cached an earlier
# installation layer. Increment this value when a new CA bundle is required.
ARG APT_CACHE_BUST=2026-10-23
RUN echo "APT cache refresh: ${APT_CACHE_BUST}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends --only-upgrade ca-certificates \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      rtl-sdr \
      unzip \
 && dpkg-query -W -f='${Package} ${Version}\n' ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN command -v rtl_test \
 && command -v rtl_fm \
 && /opt/venv/bin/python -c 'import numpy; print(numpy.__version__)'

# Vendor the tested continuation driver with the hardware_name patch.
COPY test-assets/rtldavis/rtldavis.py test-assets/rtldavis/rtldavis_receiver.py test-assets/rtldavis/rtldavis_dsp.py /opt/weewx-extensions/weewx-rtldavis/

# Vendor MQTTSubscribe into the image.
# This preserves the manually installed service across image rebuilds.
ARG MQTT_SUBSCRIBE_VERSION=3.0.0

RUN mkdir -p /opt/weewx-extensions/MQTTSubscribe \
 && curl -L "https://github.com/weewx-mqtt/subscribe/archive/refs/tags/v${MQTT_SUBSCRIBE_VERSION}.zip" -o /tmp/MQTTSubscribe.zip \
 && unzip /tmp/MQTTSubscribe.zip -d /tmp \
 && find /tmp -name MQTTSubscribe.py -exec cp {} /opt/weewx-extensions/MQTTSubscribe/MQTTSubscribe.py \; \
 && test -f /opt/weewx-extensions/MQTTSubscribe/MQTTSubscribe.py \
 && rm -rf /tmp/MQTTSubscribe.zip /tmp/subscribe-*

# Vendor the patched WeeWX MQTT RESTful extension into the image.
# Pull from Chris's maintained fork instead of copying a local patch file.
ARG WEEWX_MQTT_REPO=https://github.com/cdavis289/weewx-mqtt.git
ARG WEEWX_MQTT_REF=paho2-weewx5

RUN mkdir -p /opt/weewx-extensions/weewx-mqtt \
 && git clone --depth 1 --branch "$WEEWX_MQTT_REF" "$WEEWX_MQTT_REPO" /tmp/weewx-mqtt \
 && cp /tmp/weewx-mqtt/bin/user/mqtt.py /opt/weewx-extensions/weewx-mqtt/mqtt.py \
 && test -f /opt/weewx-extensions/weewx-mqtt/mqtt.py \
 && rm -rf /tmp/weewx-mqtt

# Vendor Belchertown New into the image.
# Pin a tested development commit to prevent unexpected changes during rebuilds.
ARG BELCHERTOWN_REPO=https://github.com/uajqq/weewx-belchertown-new.git
ARG BELCHERTOWN_REF=f61c2dd877f9f0af4c7edfb68f88c4af6348c8ac

RUN rm -rf /opt/weewx-extensions/weewx-belchertown-new /tmp/weewx-belchertown-new \
 && mkdir -p /opt/weewx-extensions/weewx-belchertown-new/bin/user \
 && git clone "$BELCHERTOWN_REPO" /tmp/weewx-belchertown-new \
 && git -C /tmp/weewx-belchertown-new checkout --detach "$BELCHERTOWN_REF" \
 && echo "Belchertown ref requested: $BELCHERTOWN_REF" \
 && git -C /tmp/weewx-belchertown-new rev-parse --short HEAD \
 && grep -n 'log.info("version' /tmp/weewx-belchertown-new/bin/user/new_belchertown.py \
 && cp -a /tmp/weewx-belchertown-new/skins/new-belchertown /opt/weewx-extensions/weewx-belchertown-new/new-belchertown \
 && cp /tmp/weewx-belchertown-new/bin/user/new_belchertown.py /opt/weewx-extensions/weewx-belchertown-new/bin/user/new_belchertown.py \
 && test -f /opt/weewx-extensions/weewx-belchertown-new/new-belchertown/skin.conf \
 && test -f /opt/weewx-extensions/weewx-belchertown-new/new-belchertown/charts.conf.example \
 && test -f /opt/weewx-extensions/weewx-belchertown-new/bin/user/new_belchertown.py \
 && rm -rf /tmp/weewx-belchertown-new

RUN cat > /usr/local/bin/start-weewx-rtldavis-overlay <<'EOF'
#!/usr/bin/env bash
set -e

if [ -d /home/weewx/public_html ]; then
  chown -R weewx:weewx /home/weewx/public_html || true
fi

mkdir -p /data/bin/user
mkdir -p /data/skins/new-belchertown

echo "Installing/updating weewx-rtldavis driver into /data/bin/user/rtldavis.py"
cp /opt/weewx-extensions/weewx-rtldavis/rtldavis*.py /data/bin/user/

if [ ! -f /data/bin/user/MQTTSubscribe.py ]; then
  echo "Installing WeeWX MQTTSubscribe service into /data/bin/user/MQTTSubscribe.py"
  cp /opt/weewx-extensions/MQTTSubscribe/MQTTSubscribe.py /data/bin/user/MQTTSubscribe.py
fi

echo "Installing patched WeeWX MQTT extension into /data/bin/user/mqtt.py"
cp /opt/weewx-extensions/weewx-mqtt/mqtt.py /data/bin/user/mqtt.py

if [ -f /data/skins/new-belchertown/charts.conf ]; then
  echo "Preserving existing custom Belchertown charts.conf"
  cp /data/skins/new-belchertown/charts.conf /tmp/belchertown-charts.conf
fi

echo "Installing/updating Belchertown New skin into /data/skins/new-belchertown"
rm -rf /data/skins/new-belchertown
mkdir -p /data/skins/new-belchertown
cp -a /opt/weewx-extensions/weewx-belchertown-new/new-belchertown/. \
  /data/skins/new-belchertown/

if [ -f /tmp/belchertown-charts.conf ]; then
  cp /tmp/belchertown-charts.conf /data/skins/new-belchertown/charts.conf
elif [ ! -f /data/skins/new-belchertown/charts.conf ] && [ -f /data/skins/new-belchertown/charts.conf.example ]; then
  echo "Creating initial Belchertown charts.conf from charts.conf.example"
  cp /data/skins/new-belchertown/charts.conf.example /data/skins/new-belchertown/charts.conf
fi

echo "Installing/updating Belchertown New Python extension into /data/bin/user/new_belchertown.py"
cp /opt/weewx-extensions/weewx-belchertown-new/bin/user/new_belchertown.py /data/bin/user/new_belchertown.py

chown -R weewx:weewx /data/bin/user /data/skins/new-belchertown 2>/dev/null || true

exec weewxd --config /data/weewx.conf
EOF

RUN chmod +x /usr/local/bin/start-weewx-rtldavis-overlay

ENTRYPOINT ["/usr/local/bin/start-weewx-rtldavis-overlay"]
CMD []
