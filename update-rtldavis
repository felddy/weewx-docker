#!/usr/bin/env python3
"""Update RTL-Davis receiver and bundled driver from a stable release."""

# Standard Python Libraries
import ast
import json
from pathlib import Path
import re
import sys
import urllib.request

REPOSITORY = "weewx-packages/weewx-rtldavis"
DOCKERFILE = Path("Dockerfile.rtldavis")
DRIVER = Path("test-assets/rtldavis/rtldavis.py")
RECEIVER = Path("test-assets/rtldavis/rtldavis_receiver.py")
DSP = Path("test-assets/rtldavis/rtldavis_dsp.py")


def fail(message):
    """Exit with an error message."""
    raise SystemExit(f"ERROR: {message}")


def fetch_json(url):
    """Fetch a JSON document from a URL."""
    request = urllib.request.Request(
        url, headers={"User-Agent": "weewx-docker-rtldavis-updater"}
    )
    if request.type != "https":
        fail("Only HTTPS URLs are permitted")
    with urllib.request.urlopen(request, timeout=30) as response:  # nosec B310
        return json.load(response)


def fetch_text(url):
    """Fetch a UTF-8 text document from a URL."""
    request = urllib.request.Request(
        url, headers={"User-Agent": "weewx-docker-rtldavis-updater"}
    )
    if request.type != "https":
        fail("Only HTTPS URLs are permitted")
    with urllib.request.urlopen(request, timeout=30) as response:  # nosec B310
        return response.read().decode("utf-8")


def replace_once(text, old, new, description):
    """Replace exactly one occurrence of a string or terminate."""
    count = text.count(old)
    if count != 1:
        fail(f"{description}: expected one match, found {count}")
    return text.replace(old, new, 1)


def main():
    """Validate an upstream release and update the pinned driver."""
    if len(sys.argv) != 2:
        fail("Usage: ./update-rtldavis vX.Y.Z")

    tag = sys.argv[1]
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", tag):
        fail(f"Invalid stable release tag: {tag}")

    if not DOCKERFILE.is_file() or not all(
        path.is_file() for path in (DRIVER, RECEIVER, DSP)
    ):
        fail("Dockerfile or bundled RTL-Davis driver is missing")

    print(f"Checking upstream release {tag}...")
    release = fetch_json(
        f"https://api.github.com/repos/{REPOSITORY}/releases/tags/{tag}"
    )

    if release.get("draft") or release.get("prerelease"):
        fail(f"{tag} is a draft or prerelease")
    if release.get("tag_name") != tag:
        fail("GitHub returned an unexpected release tag")

    docker_text = DOCKERFILE.read_text()

    matches = re.findall(
        r"^ARG RTL_DAVIS_REF=(v[0-9]+\.[0-9]+\.[0-9]+)$",
        docker_text,
        flags=re.MULTILINE,
    )
    if len(matches) != 1:
        fail("Expected exactly one RTL_DAVIS_REF declaration")

    old_tag = matches[0]
    if old_tag == tag:
        print(f"RTL-Davis is already pinned to {tag}. No changes.")
        return

    print(f"Updating {old_tag} -> {tag}")

    upstream_url = (
        f"https://raw.githubusercontent.com/{REPOSITORY}/" f"{tag}/bin/user/rtldavis.py"
    )
    upstream = fetch_text(upstream_url)

    expected_version = tag.removeprefix("v")
    version_matches = re.findall(
        r"^DRIVER_VERSION\s*=\s*['\"]([^'\"]+)['\"]",
        upstream,
        flags=re.MULTILINE,
    )
    if version_matches != [expected_version]:
        fail(
            f"Driver version mismatch: expected {expected_version}, "
            f"found {version_matches}"
        )

    upstream = replace_once(
        upstream,
        "        stn_dict = config_dict.get(DRIVER_NAME, {})\n",
        "        stn_dict = config_dict.get(DRIVER_NAME, {})\n"
        "        self._hardware_name = stn_dict.get('hardware_name', 'Rtldavis')\n",
        "hardware_name initialization",
    )
    upstream = replace_once(
        upstream,
        "    def hardware_name(self):\n        return 'Rtldavis'\n",
        "    def hardware_name(self):\n        return self._hardware_name\n",
        "hardware_name property",
    )

    upstream = "\n".join(line.rstrip(" \t") for line in upstream.split("\n"))
    ast.parse(upstream, filename=str(DRIVER))

    updated_docker = replace_once(
        docker_text,
        f"ARG RTL_DAVIS_REF={old_tag}",
        f"ARG RTL_DAVIS_REF={tag}",
        "Dockerfile receiver version",
    )

    receiver = fetch_text(
        f"https://raw.githubusercontent.com/{REPOSITORY}/{tag}/bin/user/rtldavis_receiver.py"
    )
    dsp = fetch_text(
        f"https://raw.githubusercontent.com/{REPOSITORY}/{tag}/bin/user/rtldavis_dsp.py"
    )
    ast.parse(receiver, filename=str(RECEIVER))
    ast.parse(dsp, filename=str(DSP))

    # All validation is complete before files are changed.
    DOCKERFILE.write_text(updated_docker)
    DRIVER.write_text(upstream)
    RECEIVER.write_text(receiver)
    DSP.write_text(dsp)

    print(f"Updated {DOCKERFILE}, {DRIVER}, {RECEIVER}, and {DSP}")
    print("Hardware-name customization preserved.")
    print("Python syntax validation passed.")


if __name__ == "__main__":
    main()
